   ]
  },
  "_SSTicketNoRoomText": {
   "kind": "text",
   "src": "text/BillsHouse.asm:64",
   "commands": [
    {"cmd": "text", "str": "You've got too"},
    {"cmd": "line", "str": "much stuff, bud!"},
    {"cmd": "done"}
   ]
  },
  "_BillsHouseBillWhyDontYouGoInsteadOfMeText": {
   "kind": "text",
   "src": "text/BillsHouse.asm:69",
   "commands": [
    {"cmd": "text", "str": "That cruise ship,"},
    {"cmd": "line", "str": "S.S.ANNE, is in"},
    {"cmd": "cont", "str": "VERMILION CITY."},
    {"cmd": "cont", "str": "Its passengers"},
    {"cmd": "cont", "str": "are all trainers!"},
    {"cmd": "para", "str": "They invited me"},
    {"cmd": "line", "str": "to their party,"},
    {"cmd": "cont", "str": "but I can't stand"},
    {"cmd": "cont", "str": "fancy do's. Why"},
    {"cmd": "cont", "str": "don't you go"},
    {"cmd": "cont", "str": "instead of me?"},
    {"cmd": "done"}
   ]
  },
  "_BillsHouseBillCheckOutMyRarePokemonText": {
   "kind": "text",
   "src": "text/BillsHouse.asm:84",
   "commands": [
    {"cmd": "text", "str": "BILL: Look, bud,"},
    {"cmd": "line", "str": "just check out"},
    {"cmd": "cont", "str": "some of my rare"},
    {"cmd": "cont", "str": "POKéMON on my PC!"},
    {"cmd": "done"}
