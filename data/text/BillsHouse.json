  "_BillsHouseBillImNotAPokemonText": {
   "kind": "text",
   "src": "text/BillsHouse.asm:2",
   "commands": [
    {"cmd": "text", "str": "Hiya! I'm a"},
    {"cmd": "line", "str": "POKéMON..."},
    {"cmd": "cont", "str": "...No I'm not!"},
    {"cmd": "para", "str": "Call me BILL!"},
    {"cmd": "line", "str": "I'm a true blue"},
    {"cmd": "cont", "str": "POKéMANIAC! Hey!"},
    {"cmd": "cont", "str": "What's with that"},
    {"cmd": "cont", "str": "skeptical look?"},
    {"cmd": "para", "str": "I'm not joshing"},
    {"cmd": "line", "str": "you, I screwed up"},
    {"cmd": "cont", "str": "an experiment and"},
    {"cmd": "cont", "str": "got combined with"},
    {"cmd": "cont", "str": "a POKéMON!"},
    {"cmd": "para", "str": "So, how about it?"},
    {"cmd": "line", "str": "Help me out here!"},
    {"cmd": "done"}
   ]
  },
  "_BillsHouseBillUseSeparationSystemText": {
   "kind": "text",
   "src": "text/BillsHouse.asm:23",
   "commands": [
    {"cmd": "text", "str": "When I'm in the"},
    {"cmd": "line", "str": "TELEPORTER, go to"},
    {"cmd": "cont", "str": "my PC and run the"},
    {"cmd": "cont", "str": "Cell Separation"},
    {"cmd": "cont", "str": "System!"},
    {"cmd": "done"}
   ]
  },
  "_BillsHouseBillNoYouGottaHelpText": {
   "kind": "text",
   "src": "text/BillsHouse.asm:31",
   "commands": [
    {"cmd": "text", "str": "No!? Come on, you"},
    {"cmd": "line", "str": "gotta help a guy"},
    {"cmd": "cont", "str": "in deep trouble!"},
    {"cmd": "para", "str": "What do you say,"},
    {"cmd": "line", "str": "chief? Please?"},
    {"cmd": "cont", "str": "OK? All right!"},
    {"cmd": "prompt"}
   ]
  },
  "_BillsHouseBillThankYouText": {
   "kind": "text",
   "src": "text/BillsHouse.asm:41",
   "commands": [
    {"cmd": "text", "str": "BILL: Yeehah!"},
    {"cmd": "line", "str": "Thanks, bud! I"},
    {"cmd": "cont", "str": "owe you one!"},
    {"cmd": "para", "str": "So, did you come"},
    {"cmd": "line", "str": "to see my POKéMON"},
    {"cmd": "cont", "str": "collection?"},
    {"cmd": "cont", "str": "You didn't?"},
    {"cmd": "cont", "str": "That's a bummer."},
    {"cmd": "para", "str": "I've got to thank"},
    {"cmd": "line", "str": "you... Oh here,"},
    {"cmd": "cont", "str": "maybe this'll do."},
    {"cmd": "prompt"}
   ]
  },
  "_SSTicketReceivedText": {
   "kind": "text",
