  "_SSAnne2FWaiterText": {
   "kind": "text",
   "src": "text/SSAnne2F.asm:2",
   "commands": [
    {"cmd": "text", "str": "This ship, she is"},
    {"cmd": "line", "str": "a luxury liner"},
    {"cmd": "cont", "str": "for trainers!"},
    {"cmd": "para", "str": "At every port, we"},
    {"cmd": "line", "str": "hold parties with"},
    {"cmd": "cont", "str": "invited trainers!"},
    {"cmd": "done"}
   ]
  },
  "_SSAnne2FRivalText": {
   "kind": "text",
   "src": "text/SSAnne2F.asm:12",
   "commands": [
    {"cmd": "text", "str": "{RIVAL}: Bonjour!"},
    {"cmd": "line", "str": "{PLAYER}!"},
    {"cmd": "para", "str": "Imagine seeing"},
    {"cmd": "line", "str": "you here!"},
    {"cmd": "para", "str": "{PLAYER}, were you"},
    {"cmd": "line", "str": "really invited?"},
    {"cmd": "para", "str": "So how's your"},
    {"cmd": "line", "str": "POKéDEX coming?"},
    {"cmd": "para", "str": "I already caught"},
    {"cmd": "line", "str": "40 kinds, pal!"},
    {"cmd": "para", "str": "Different kinds"},
    {"cmd": "line", "str": "are everywhere!"},
    {"cmd": "para", "str": "Crawl around in"},
    {"cmd": "line", "str": "grassy areas!"},
    {"cmd": "done"}
   ]
  },
  "_SSAnne2FRivalDefeatedText": {
   "kind": "text",
   "src": "text/SSAnne2F.asm:35",
   "commands": [
    {"cmd": "text", "str": "Humph!"},
    {"cmd": "para", "str": "At least you're"},
    {"cmd": "line", "str": "raising your"},
    {"cmd": "cont", "str": "POKéMON!"},
    {"cmd": "prompt"}
   ]
  },
  "_SSAnne2FRivalVictoryText": {
   "kind": "text",
   "src": "text/SSAnne2F.asm:43",
   "commands": [
    {"cmd": "text", "str": "{PLAYER}! What are"},
    {"cmd": "line", "str": "you, seasick?"},
    {"cmd": "para", "str": "You should shape"},
    {"cmd": "line", "str": "up, pal!"},
    {"cmd": "prompt"}
   ]
  },
  "_SSAnne2FRivalCutMasterText": {
   "kind": "text",
   "src": "text/SSAnne2F.asm:51",
   "commands": [
    {"cmd": "text", "str": "{RIVAL}: I heard"},
    {"cmd": "line", "str": "there was a CUT"},
    {"cmd": "cont", "str": "master on board."},
    {"cmd": "para", "str": "But, he was just a"},
    {"cmd": "line", "str": "seasick, old man!"},
    {"cmd": "para", "str": "But, CUT itself is"},
    {"cmd": "line", "str": "really useful!"},
    {"cmd": "para", "str": "You should go see"},
    {"cmd": "line", "str": "him! Smell ya!"},
    {"cmd": "done"}
