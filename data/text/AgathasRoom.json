  },
  "_AgathaAfterBattleText": {
   "kind": "text",
   "src": "text/AgathasRoom.asm:32",
   "commands": [
    {"cmd": "text", "str": "You win! I see"},
    {"cmd": "line", "str": "what the old duff"},
    {"cmd": "cont", "str": "sees in you now!"},
    {"cmd": "para", "str": "I have nothing"},
    {"cmd": "line", "str": "else to say! Run"},
    {"cmd": "cont", "str": "along now, child!"},
    {"cmd": "done"}
   ]
  },
