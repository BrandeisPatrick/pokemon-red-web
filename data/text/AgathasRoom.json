  "_AgathaBeforeBattleText": {
   "kind": "text",
   "src": "text/AgathasRoom.asm:2",
   "commands": [
    {"cmd": "text", "str": "I am AGATHA of"},
    {"cmd": "line", "str": "the ELITE FOUR!"},
    {"cmd": "para", "str": "OAK's taken a lot"},
    {"cmd": "line", "str": "of interest in"},
    {"cmd": "cont", "str": "you, child!"},
    {"cmd": "para", "str": "That old duff was"},
    {"cmd": "line", "str": "once tough and"},
    {"cmd": "cont", "str": "handsome! That"},
    {"cmd": "cont", "str": "was decades ago!"},
    {"cmd": "para", "str": "Now he just wants"},
    {"cmd": "line", "str": "to fiddle with"},
    {"cmd": "cont", "str": "his POKéDEX! He's"},
    {"cmd": "cont", "str": "wrong! POKéMON"},
    {"cmd": "cont", "str": "are for fighting!"},
    {"cmd": "para", "str": "{PLAYER}! I'll show"},
    {"cmd": "line", "str": "you how a real"},
    {"cmd": "cont", "str": "trainer fights!"},
    {"cmd": "done"}
   ]
  },
  "_AgathaEndBattleText": {
   "kind": "text",
   "src": "text/AgathasRoom.asm:26",
   "commands": [
    {"cmd": "text", "str": "Oh ho!"},
    {"cmd": "line", "str": "You're something"},
    {"cmd": "cont", "str": "special, child!"},
    {"cmd": "prompt"}
