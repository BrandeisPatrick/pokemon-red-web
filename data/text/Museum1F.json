    {"cmd": "cont", "str": "be resurrected"},
    {"cmd": "cont", "str": "from it!"},
    {"cmd": "para", "str": "But, my colleagues"},
    {"cmd": "line", "str": "just ignore me!"},
    {"cmd": "para", "str": "So I have a favor"},
    {"cmd": "line", "str": "to ask!"},
    {"cmd": "para", "str": "Take this to a"},
    {"cmd": "line", "str": "POKéMON LAB and"},
    {"cmd": "cont", "str": "get it examined!"},
    {"cmd": "prompt"}
