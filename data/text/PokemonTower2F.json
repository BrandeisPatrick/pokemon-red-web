   "src": "text/PokemonTower2F.asm:22",
   "commands": [
    {"cmd": "text", "str": "{RIVAL}: Well,"},
    {"cmd": "line", "str": "look at all your"},
    {"cmd": "cont", "str": "wimpy POKéMON!"},
    {"cmd": "para", "str": "Toughen them up a"},
