   "kind": "text",
   "src": "text/PokemonTower2F.asm:2",
   "commands": [
    {"cmd": "text", "str": "{RIVAL}: Hey,"},
    {"cmd": "line", "str": "{PLAYER}! What"},
    {"cmd": "cont", "str": "brings you here?"},
    {"cmd": "cont", "str": "Your POKéMON"},
    {"cmd": "cont", "str": "don't look dead!"},
    {"cmd": "para", "str": "I can at least"},
    {"cmd": "line", "str": "make them faint!"},
    {"cmd": "cont", "str": "Let's go, pal!"},
    {"cmd": "done"}
   ]
  },
