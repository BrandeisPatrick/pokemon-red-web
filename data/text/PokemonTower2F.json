  "_PokemonTower2FRivalHowsYourDexText": {
   "kind": "text",
   "src": "text/PokemonTower2F.asm:31",
   "commands": [
    {"cmd": "text", "str": "How's your POKéDEX"},
    {"cmd": "line", "str": "coming, pal?"},
    {"cmd": "cont", "str": "I just caught a"},
    {"cmd": "cont", "str": "CUBONE!"},
    {"cmd": "para", "str": "I can't find the"},
    {"cmd": "line", "str": "grown-up MAROWAK"},
    {"cmd": "cont", "str": "yet!"},
    {"cmd": "para", "str": "I doubt there are"},
    {"cmd": "line", "str": "any left! Well, I"},
    {"cmd": "cont", "str": "better get going!"},
    {"cmd": "cont", "str": "I've got a lot to"},
    {"cmd": "cont", "str": "accomplish, pal!"},
    {"cmd": "para", "str": "Smell ya later!"},
    {"cmd": "done"}
   ]
  },
