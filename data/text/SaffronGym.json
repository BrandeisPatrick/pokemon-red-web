  "_SaffronGymSabrinaText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:2",
   "commands": [
    {"cmd": "text", "str": "I had a vision of"},
    {"cmd": "line", "str": "your arrival!"},
    {"cmd": "para", "str": "I have had psychic"},
    {"cmd": "line", "str": "powers since I"},
    {"cmd": "cont", "str": "was a child."},
    {"cmd": "para", "str": "I first learned"},
    {"cmd": "line", "str": "to bend spoons"},
    {"cmd": "cont", "str": "with my mind."},
    {"cmd": "para", "str": "I dislike fight-"},
    {"cmd": "line", "str": "ing, but if you"},
    {"cmd": "cont", "str": "wish, I will show"},
    {"cmd": "cont", "str": "you my powers!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymSabrinaReceivedMarshBadgeText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:20",
   "commands": [
    {"cmd": "text", "str": "I'm"},
    {"cmd": "line", "str": "shocked!"},
    {"cmd": "cont", "str": "But, a loss is a"},
    {"cmd": "cont", "str": "loss."},
    {"cmd": "para", "str": "I admit I didn't"},
    {"cmd": "line", "str": "work hard enough"},
    {"cmd": "cont", "str": "to win!"},
    {"cmd": "para", "str": "You earned the"},
    {"cmd": "line", "str": "MARSHBADGE!"},
    {"cmd": "text_end"}
   ]
  },
  "_SaffronGymSabrinaPostBattleAdviceText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:34",
   "commands": [
    {"cmd": "text", "str": "Everyone has"},
    {"cmd": "line", "str": "psychic power!"},
    {"cmd": "cont", "str": "People just don't"},
    {"cmd": "cont", "str": "realize it!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymSabrinaMarshBadgeInfoText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:41",
   "commands": [
    {"cmd": "text", "str": "The MARSHBADGE"},
    {"cmd": "line", "str": "makes POKéMON up"},
    {"cmd": "cont", "str": "to L70 obey you!"},
    {"cmd": "para", "str": "Stronger POKéMON"},
    {"cmd": "line", "str": "will become wild,"},
    {"cmd": "cont", "str": "ignoring your"},
    {"cmd": "cont", "str": "orders in battle!"},
    {"cmd": "para", "str": "Just don't raise"},
    {"cmd": "line", "str": "your POKéMON too"},
    {"cmd": "cont", "str": "much!"},
    {"cmd": "para", "str": "Wait, please take"},
    {"cmd": "line", "str": "this TM with you!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymSabrinaReceivedTM46Text": {
   "kind": "text",
   "src": "text/SaffronGym.asm:59",
   "commands": [
    {"cmd": "text", "str": "{PLAYER} received"},
    {"cmd": "line", "str": "TM46!"},
    {"cmd": "text_end"}
   ]
  },
  "_TM46ExplanationText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:64",
   "commands": [
    {"cmd": "text", "str": ""},
    {"cmd": "para", "str": "TM46 is PSYWAVE!"},
    {"cmd": "line", "str": "It uses powerful"},
    {"cmd": "cont", "str": "psychic waves to"},
    {"cmd": "cont", "str": "inflict damage!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymSabrinaTM46NoRoomText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:73",
   "commands": [
    {"cmd": "text", "str": "Your pack is full"},
    {"cmd": "line", "str": "of other items!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymGuideChampInMakingText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:78",
   "commands": [
    {"cmd": "text", "str": "Yo! Champ in"},
    {"cmd": "line", "str": "making!"},
    {"cmd": "para", "str": "SABRINA's POKéMON"},
    {"cmd": "line", "str": "use psychic power"},
    {"cmd": "cont", "str": "instead of force!"},
    {"cmd": "para", "str": "Fighting POKéMON"},
    {"cmd": "line", "str": "are weak against"},
    {"cmd": "cont", "str": "psychic POKéMON!"},
    {"cmd": "para", "str": "They get creamed"},
    {"cmd": "line", "str": "before they can"},
    {"cmd": "cont", "str": "even aim a punch!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymGuideBeatSabrinaText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:95",
   "commands": [
    {"cmd": "text", "str": "Psychic power,"},
    {"cmd": "line", "str": "huh?"},
    {"cmd": "para", "str": "If I had that,"},
    {"cmd": "line", "str": "I'd make a bundle"},
    {"cmd": "cont", "str": "at the slots!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymChanneler1BattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:104",
   "commands": [
    {"cmd": "text", "str": "SABRINA is younger"},
    {"cmd": "line", "str": "than I, but I"},
    {"cmd": "cont", "str": "respect her!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymChanneler1EndBattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:110",
   "commands": [
    {"cmd": "text", "str": "Not"},
    {"cmd": "line", "str": "good enough!"},
    {"cmd": "prompt"}
   ]
  },
  "_SaffronGymChanneler1AfterBattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:115",
   "commands": [
    {"cmd": "text", "str": "In a battle of"},
    {"cmd": "line", "str": "equals, the one"},
    {"cmd": "cont", "str": "with the stronger"},
    {"cmd": "cont", "str": "will wins!"},
    {"cmd": "para", "str": "If you wish"},
    {"cmd": "line", "str": "to beat SABRINA,"},
    {"cmd": "cont", "str": "focus on winning!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymYoungster1BattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:126",
   "commands": [
    {"cmd": "text", "str": "Does our unseen"},
    {"cmd": "line", "str": "power scare you?"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymYoungster1EndBattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:131",
   "commands": [
    {"cmd": "text", "str": "I never"},
    {"cmd": "line", "str": "foresaw this!"},
    {"cmd": "prompt"}
   ]
  },
  "_SaffronGymYoungster1AfterBattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:136",
   "commands": [
    {"cmd": "text", "str": "Psychic POKéMON"},
    {"cmd": "line", "str": "fear only ghosts"},
    {"cmd": "cont", "str": "and bugs!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymChanneler2BattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:142",
   "commands": [
    {"cmd": "text", "str": "POKéMON take on"},
    {"cmd": "line", "str": "the appearance of"},
    {"cmd": "cont", "str": "their trainers."},
    {"cmd": "para", "str": "Your POKéMON must"},
    {"cmd": "line", "str": "be tough, then!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymChanneler2EndBattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:151",
   "commands": [
    {"cmd": "text", "str": "I knew"},
    {"cmd": "line", "str": "it!"},
    {"cmd": "prompt"}
   ]
  },
  "_SaffronGymChanneler2AfterBattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:156",
   "commands": [
    {"cmd": "text", "str": "I must teach"},
    {"cmd": "line", "str": "better techniques"},
    {"cmd": "cont", "str": "to my POKéMON!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymYoungster2BattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:162",
   "commands": [
    {"cmd": "text", "str": "You know that"},
    {"cmd": "line", "str": "power alone isn't"},
    {"cmd": "cont", "str": "enough!"},
    {"cmd": "done"}
   ]
  },
  "_SaffronGymYoungster2EndBattleText": {
   "kind": "text",
   "src": "text/SaffronGym.asm:168",
   "commands": [
    {"cmd": "text", "str": "I don't"},
