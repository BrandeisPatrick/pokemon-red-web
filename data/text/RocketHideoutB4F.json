  "_RocketHideoutB4FGiovanniHopeWeMeetAgainText": {
   "kind": "text",
   "src": "text/RocketHideoutB4F.asm:13",
   "commands": [
    {"cmd": "text", "str": "I see that you"},
    {"cmd": "line", "str": "raise POKéMON"},
    {"cmd": "cont", "str": "with utmost care."},
    {"cmd": "para", "str": "A child like you"},
    {"cmd": "line", "str": "would never"},
    {"cmd": "cont", "str": "understand what I"},
    {"cmd": "cont", "str": "hope to achieve."},
    {"cmd": "para", "str": "I shall step"},
    {"cmd": "line", "str": "aside this time!"},
    {"cmd": "para", "str": "I hope we meet"},
    {"cmd": "line", "str": "again..."},
    {"cmd": "done"}
   ]
  },
