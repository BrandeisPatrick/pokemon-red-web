  },
  "_FightingDojoKarateMasterIWillGiveYouAPokemonText": {
   "kind": "text",
   "src": "text/FightingDojo.asm:21",
   "commands": [
    {"cmd": "text", "str": "Indeed, I have"},
    {"cmd": "line", "str": "lost!"},
    {"cmd": "para", "str": "But, I beseech"},
    {"cmd": "line", "str": "you, do not take"},
    {"cmd": "cont", "str": "our emblem as"},
    {"cmd": "cont", "str": "your trophy!"},
    {"cmd": "para", "str": "In return, I will"},
    {"cmd": "line", "str": "give you a prized"},
    {"cmd": "cont", "str": "fighting POKéMON!"},
    {"cmd": "para", "str": "Choose whichever"},
    {"cmd": "line", "str": "one you like!"},
    {"cmd": "done"}
   ]
  },
