  "_FightingDojoKarateMasterText": {
   "kind": "text",
   "src": "text/FightingDojo.asm:2",
   "commands": [
    {"cmd": "text", "str": "Grunt!"},
    {"cmd": "para", "str": "I am the KARATE"},
    {"cmd": "line", "str": "MASTER! I am the"},
    {"cmd": "cont", "str": "LEADER here!"},
    {"cmd": "para", "str": "You wish to"},
    {"cmd": "line", "str": "challenge us?"},
    {"cmd": "cont", "str": "Expect no mercy!"},
    {"cmd": "para", "str": "Fwaaa!"},
    {"cmd": "done"}
   ]
  },
