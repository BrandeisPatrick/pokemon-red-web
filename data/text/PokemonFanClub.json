  "_PokemonFanClubPikachuFanBetterText": {
   "kind": "text",
   "src": "text/PokemonFanClub.asm:8",
   "commands": [
    {"cmd": "text", "str": "Humph! My PIKACHU"},
    {"cmd": "line", "str": "is twice as cute"},
    {"cmd": "cont", "str": "as that one!"},
    {"cmd": "done"}
   ]
  },
  "_PokemonFanClubSeelFanNormalText": {
   "kind": "text",
   "src": "text/PokemonFanClub.asm:14",
   "commands": [
    {"cmd": "text", "str": "I just love my"},
    {"cmd": "line", "str": "SEEL!"},
    {"cmd": "para", "str": "It squeals when I"},
    {"cmd": "line", "str": "hug it!"},
    {"cmd": "done"}
   ]
  },
  "_PokemonFanClubSeelFanBetterText": {
   "kind": "text",
   "src": "text/PokemonFanClub.asm:22",
   "commands": [
    {"cmd": "text", "str": "Oh dear!"},
    {"cmd": "para", "str": "My SEEL is far"},
    {"cmd": "line", "str": "more attractive!"},
    {"cmd": "done"}
   ]
  },
