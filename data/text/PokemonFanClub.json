  "_PokemonFanClubChairmanIntroText": {
   "kind": "text",
   "src": "text/PokemonFanClub.asm:38",
   "commands": [
    {"cmd": "text", "str": "I chair the"},
    {"cmd": "line", "str": "POKéMON Fan Club!"},
    {"cmd": "para", "str": "I have collected"},
    {"cmd": "line", "str": "over 100 POKéMON!"},
    {"cmd": "para", "str": "I'm very fussy"},
    {"cmd": "line", "str": "when it comes to"},
    {"cmd": "cont", "str": "POKéMON!"},
    {"cmd": "para", "str": "So..."},
    {"cmd": "para", "str": "Did you come"},
    {"cmd": "line", "str": "visit to hear"},
    {"cmd": "cont", "str": "about my POKéMON?"},
    {"cmd": "done"}
   ]
  },
  "_PokemonFanClubChairmanStoryText": {
   "kind": "text",
   "src": "text/PokemonFanClub.asm:56",
   "commands": [
    {"cmd": "text", "str": "Good!"},
    {"cmd": "line", "str": "Then listen up!"},
    {"cmd": "para", "str": "My favorite"},
    {"cmd": "line", "str": "RAPIDASH..."},
    {"cmd": "para", "str": "It...cute..."},
    {"cmd": "line", "str": "lovely...smart..."},
    {"cmd": "cont", "str": "plus...amazing..."},
    {"cmd": "cont", "str": "you think so?..."},
    {"cmd": "cont", "str": "oh yes...it..."},
    {"cmd": "cont", "str": "stunning..."},
    {"cmd": "cont", "str": "kindly..."},
    {"cmd": "cont", "str": "love it!"},
    {"cmd": "para", "str": "Hug it...when..."},
    {"cmd": "cont", "str": "sleeping...warm"},
    {"cmd": "cont", "str": "and cuddly..."},
    {"cmd": "cont", "str": "spectacular..."},
    {"cmd": "cont", "str": "ravishing..."},
    {"cmd": "cont", "str": "...Oops! Look at"},
    {"cmd": "cont", "str": "the time! I kept"},
    {"cmd": "cont", "str": "you too long!"},
    {"cmd": "para", "str": "Thanks for hearing"},
    {"cmd": "line", "str": "me out! I want"},
    {"cmd": "cont", "str": "you to have this!"},
    {"cmd": "prompt"}
   ]
  },
  "_PokemonFanClubReceivedBikeVoucherText": {
   "kind": "text",
   "src": "text/PokemonFanClub.asm:86",
   "commands": [
    {"cmd": "text", "str": "{PLAYER} received"},
    {"cmd": "line", "str": "a "},
    {"cmd": "text_ram", "ram": "wStringBuffer"},
    {"cmd": "text", "str": "!"},
    {"cmd": "text_end"}
   ]
  },
  "_PokemonFanClubExplainBikeVoucherText": {
   "kind": "text",
   "src": "text/PokemonFanClub.asm:93",
   "commands": [
    {"cmd": "text", "str": ""},
    {"cmd": "para", "str": "Exchange that for"},
    {"cmd": "line", "str": "a BICYCLE!"},
    {"cmd": "para", "str": "Don't worry, my"},
    {"cmd": "line", "str": "FEAROW will FLY"},
    {"cmd": "cont", "str": "me anywhere!"},
    {"cmd": "para", "str": "So, I don't need a"},
    {"cmd": "line", "str": "BICYCLE!"},
    {"cmd": "para", "str": "I hope you like"},
    {"cmd": "line", "str": "cycling!"},
    {"cmd": "done"}
   ]
  },
  "_PokemonFanClubNoStoryText": {
   "kind": "text",
   "src": "text/PokemonFanClub.asm:110",
   "commands": [
    {"cmd": "text", "str": "Oh. Come back"},
    {"cmd": "line", "str": "when you want to"},
    {"cmd": "cont", "str": "hear my story!"},
    {"cmd": "done"}
   ]
  },
  "_PokemonFanClubChairFinalText": {
   "kind": "text",
   "src": "text/PokemonFanClub.asm:116",
   "commands": [
    {"cmd": "text", "str": "Hello, {PLAYER}!"},
    {"cmd": "para", "str": "Did you come see"},
    {"cmd": "line", "str": "me about my"},
    {"cmd": "cont", "str": "POKéMON again?"},
    {"cmd": "para", "str": "No? Too bad!"},
    {"cmd": "done"}
   ]
  },
