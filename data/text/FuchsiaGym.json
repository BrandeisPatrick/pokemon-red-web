  "_FuchsiaGymKogaBeforeBattleText": {
   "kind": "text",
   "src": "text/FuchsiaGym.asm:2",
   "commands": [
    {"cmd": "text", "str": "KOGA: Fwahahaha!"},
    {"cmd": "para", "str": "A mere child like"},
    {"cmd": "line", "str": "you dares to"},
    {"cmd": "cont", "str": "challenge me?"},
    {"cmd": "para", "str": "Very well, I"},
    {"cmd": "line", "str": "shall show you"},
    {"cmd": "cont", "str": "true terror as a"},
    {"cmd": "cont", "str": "ninja master!"},
    {"cmd": "para", "str": "You shall feel"},
    {"cmd": "line", "str": "the despair of"},
    {"cmd": "cont", "str": "poison and sleep"},
    {"cmd": "cont", "str": "techniques!"},
    {"cmd": "done"}
   ]
  },
  "_FuchsiaGymKogaReceivedSoulBadgeText": {
   "kind": "text",
   "src": "text/FuchsiaGym.asm:20",
   "commands": [
    {"cmd": "text", "str": "Humph!"},
    {"cmd": "line", "str": "You have proven"},
    {"cmd": "cont", "str": "your worth!"},
    {"cmd": "para", "str": "Here! Take the"},
    {"cmd": "line", "str": "SOULBADGE!"},
    {"cmd": "prompt"}
   ]
  },
  "_FuchsiaGymKogaPostBattleAdviceText": {
   "kind": "text",
   "src": "text/FuchsiaGym_2.asm:2",
   "commands": [
    {"cmd": "text", "str": "When afflicted by"},
    {"cmd": "line", "str": "TOXIC, POKéMON"},
    {"cmd": "cont", "str": "suffer more and"},
    {"cmd": "cont", "str": "more as battle"},
    {"cmd": "cont", "str": "progresses!"},
    {"cmd": "para", "str": "It will surely"},
    {"cmd": "line", "str": "terrorize foes!"},
    {"cmd": "done"}
   ]
  },
  "_FuchsiaGymKogaSoulBadgeInfoText": {
   "kind": "text",
   "src": "text/FuchsiaGym_2.asm:13",
   "commands": [
    {"cmd": "text", "str": "Now that you have"},
    {"cmd": "line", "str": "the SOULBADGE,"},
    {"cmd": "cont", "str": "the DEFENSE of"},
    {"cmd": "cont", "str": "your POKéMON"},
    {"cmd": "cont", "str": "increases!"},
    {"cmd": "para", "str": "It also lets you"},
    {"cmd": "line", "str": "SURF outside of"},
    {"cmd": "cont", "str": "battle!"},
    {"cmd": "para", "str": "Ah! Take this"},
    {"cmd": "line", "str": "too!"},
    {"cmd": "done"}
   ]
  },
