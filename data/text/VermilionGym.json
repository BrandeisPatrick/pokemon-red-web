  },
  "_VermilionGymSuperNerdAfterBattleText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:88",
   "commands": [
    {"cmd": "text", "str": "OK, I'll talk!"},
    {"cmd": "para", "str": "LT.SURGE said he"},
    {"cmd": "line", "str": "hid door switches"},
    {"cmd": "cont", "str": "inside something!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymSailorBattleText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:96",
   "commands": [
    {"cmd": "text", "str": "This is no place"},
    {"cmd": "line", "str": "for kids!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymSailorEndBattleText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:101",
   "commands": [
    {"cmd": "text", "str": "Wow!"},
    {"cmd": "line", "str": "Surprised me!"},
