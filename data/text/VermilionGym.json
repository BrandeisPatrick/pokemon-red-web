   ]
  },
  "_VermilionGymSailorAfterBattleText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:106",
   "commands": [
    {"cmd": "text", "str": "LT.SURGE set up"},
    {"cmd": "line", "str": "double locks!"},
    {"cmd": "cont", "str": "Here's a hint!"},
    {"cmd": "para", "str": "When you open the"},
    {"cmd": "line", "str": "1st lock, the 2nd"},
    {"cmd": "cont", "str": "lock is right"},
    {"cmd": "cont", "str": "next to it!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymGymGuideChampInMakingText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:117",
   "commands": [
    {"cmd": "text", "str": "Yo! Champ in"},
    {"cmd": "line", "str": "making!"},
    {"cmd": "para", "str": "LT.SURGE has a"},
    {"cmd": "line", "str": "nickname. People"},
    {"cmd": "cont", "str": "refer to him as"},
    {"cmd": "cont", "str": "the Lightning"},
    {"cmd": "cont", "str": "American!"},
    {"cmd": "para", "str": "He's an expert on"},
    {"cmd": "line", "str": "electric POKéMON!"},
    {"cmd": "para", "str": "Birds and water"},
    {"cmd": "line", "str": "POKéMON are at"},
    {"cmd": "cont", "str": "risk! Beware of"},
    {"cmd": "cont", "str": "paralysis too!"},
    {"cmd": "para", "str": "LT.SURGE is very"},
    {"cmd": "line", "str": "cautious!"},
    {"cmd": "para", "str": "You'll have to"},
    {"cmd": "line", "str": "break a code to"},
    {"cmd": "cont", "str": "get to him!"},
    {"cmd": "done"}
   ]
  },
