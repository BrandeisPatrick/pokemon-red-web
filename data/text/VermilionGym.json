    {"cmd": "text_end"}
   ]
  },
  "_TM24ExplanationText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:34",
   "commands": [
    {"cmd": "text", "str": ""},
    {"cmd": "para", "str": "TM24 contains"},
    {"cmd": "line", "str": "THUNDERBOLT!"},
    {"cmd": "para", "str": "Teach it to an"},
    {"cmd": "line", "str": "electric POKéMON!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymLTSurgeTM24NoRoomText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:44",
   "commands": [
    {"cmd": "text", "str": "Yo kid, make room"},
    {"cmd": "line", "str": "in your pack!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymLTSurgeReceivedThunderBadgeText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:49",
   "commands": [
    {"cmd": "text", "str": "Whoa!"},
    {"cmd": "para", "str": "You're the real"},
    {"cmd": "line", "str": "deal, kid!"},
    {"cmd": "para", "str": "Fine then, take"},
    {"cmd": "line", "str": "the THUNDERBADGE!"},
    {"cmd": "prompt"}
   ]
  },
  "_VermilionGymGentlemanBattleText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:59",
   "commands": [
    {"cmd": "text", "str": "When I was in the"},
    {"cmd": "line", "str": "Army, LT.SURGE"},
    {"cmd": "cont", "str": "was my strict CO!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymGentlemanEndBattleText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:65",
   "commands": [
    {"cmd": "text", "str": "Stop!"},
    {"cmd": "line", "str": "You're very good!"},
    {"cmd": "prompt"}
   ]
  },
  "_VermilionGymGentlemanAfterBattleText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:70",
   "commands": [
    {"cmd": "text", "str": "The door won't"},
    {"cmd": "line", "str": "open?"},
    {"cmd": "para", "str": "LT.SURGE always"},
    {"cmd": "line", "str": "was cautious!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymSuperNerdBattleText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:78",
   "commands": [
    {"cmd": "text", "str": "I'm a lightweight,"},
    {"cmd": "line", "str": "but I'm good with"},
    {"cmd": "cont", "str": "electricity!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymSuperNerdEndBattleText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:84",
