  "_VermilionGymLTSurgePreBattleText": {
   "kind": "text",
   "src": "text/VermilionGym.asm:2",
   "commands": [
    {"cmd": "text", "str": "Hey, kid! What do"},
    {"cmd": "line", "str": "you think you're"},
    {"cmd": "cont", "str": "doing here?"},
    {"cmd": "para", "str": "You won't live"},
    {"cmd": "line", "str": "long in combat!"},
    {"cmd": "cont", "str": "That's for sure!"},
    {"cmd": "para", "str": "I tell you kid,"},
    {"cmd": "line", "str": "electric POKéMON"},
    {"cmd": "cont", "str": "saved me during"},
    {"cmd": "cont", "str": "the war!"},
    {"cmd": "para", "str": "They zapped my"},
    {"cmd": "line", "str": "enemies into"},
    {"cmd": "cont", "str": "paralysis!"},
    {"cmd": "para", "str": "The same as I'll"},
    {"cmd": "line", "str": "do to you!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymLTSurgePostBattleAdviceText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:2",
   "commands": [
    {"cmd": "text", "str": "A little word of"},
    {"cmd": "line", "str": "advice, kid!"},
    {"cmd": "para", "str": "Electricity is"},
    {"cmd": "line", "str": "sure powerful!"},
    {"cmd": "para", "str": "But, it's useless"},
    {"cmd": "line", "str": "against ground-"},
    {"cmd": "cont", "str": "type POKéMON!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymLTSurgeThunderBadgeInfoText": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:14",
   "commands": [
    {"cmd": "text", "str": "The THUNDERBADGE"},
    {"cmd": "line", "str": "cranks up your"},
    {"cmd": "cont", "str": "POKéMON's SPEED!"},
    {"cmd": "para", "str": "It also lets your"},
    {"cmd": "line", "str": "POKéMON FLY any"},
    {"cmd": "cont", "str": "time, kid!"},
    {"cmd": "para", "str": "You're special,"},
    {"cmd": "line", "str": "kid! Take this!"},
    {"cmd": "done"}
   ]
  },
  "_VermilionGymLTSurgeReceivedTM24Text": {
   "kind": "text",
   "src": "text/VermilionGym_2.asm:27",
