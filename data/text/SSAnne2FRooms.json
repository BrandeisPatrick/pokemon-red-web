  "_SSAnne2FRoomsGentleman3Text": {
   "kind": "text",
   "src": "text/SSAnne2FRooms.asm:2",
   "commands": [
    {"cmd": "text", "str": "In all my travels"},
    {"cmd": "line", "str": "I've never seen"},
    {"cmd": "cont", "str": "any POKéMON sleep"},
    {"cmd": "cont", "str": "like this one!"},
    {"cmd": "para", "str": "It was something"},
    {"cmd": "line", "str": "like this!"},
    {"cmd": "prompt"}
   ]
  },
  "_SSAnne2FRoomsGentleman4Text": {
   "kind": "text",
   "src": "text/SSAnne2FRooms.asm:12",
   "commands": [
    {"cmd": "text", "str": "Ah yes, I have"},
    {"cmd": "line", "str": "seen some POKéMON"},
    {"cmd": "cont", "str": "ferry people"},
    {"cmd": "cont", "str": "across the water!"},
    {"cmd": "done"}
   ]
  },
  "_SSAnne2FRoomsGrampsText": {
   "kind": "text",
   "src": "text/SSAnne2FRooms.asm:19",
