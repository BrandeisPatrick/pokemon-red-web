    {"cmd": "done"}
   ]
  },
  "_SSAnne2FRoomsGentleman5Text": {
   "kind": "text",
   "src": "text/SSAnne2FRooms.asm:24",
   "commands": [
    {"cmd": "text", "str": "Have you gone to"},
    {"cmd": "line", "str": "the SAFARI ZONE"},
    {"cmd": "cont", "str": "in FUCHSIA CITY?"},
    {"cmd": "para", "str": "It had many rare"},
    {"cmd": "line", "str": "kinds of POKéMON!!"},
    {"cmd": "done"}
   ]
  },
