  "_CeruleanGymMistyPreBattleText": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:2",
   "commands": [
    {"cmd": "text", "str": "Hi, you're a new"},
    {"cmd": "line", "str": "face!"},
    {"cmd": "para", "str": "Trainers who want"},
    {"cmd": "line", "str": "to turn pro have"},
    {"cmd": "cont", "str": "to have a policy"},
    {"cmd": "cont", "str": "about POKéMON!"},
    {"cmd": "para", "str": "What is your"},
    {"cmd": "line", "str": "approach when you"},
    {"cmd": "cont", "str": "catch POKéMON?"},
    {"cmd": "para", "str": "My policy is an"},
    {"cmd": "line", "str": "all-out offensive"},
    {"cmd": "cont", "str": "with water-type"},
    {"cmd": "cont", "str": "POKéMON!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanGymMistyTM11ExplanationText": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:21",
   "commands": [
    {"cmd": "text", "str": "TM11 teaches"},
    {"cmd": "line", "str": "BUBBLEBEAM!"},
    {"cmd": "para", "str": "Use it on an"},
    {"cmd": "line", "str": "aquatic POKéMON!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanGymMistyCascadeBadgeInfoText": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:29",
   "commands": [
    {"cmd": "text", "str": "The CASCADEBADGE"},
    {"cmd": "line", "str": "makes all POKéMON"},
    {"cmd": "cont", "str": "up to L30 obey!"},
    {"cmd": "para", "str": "That includes"},
    {"cmd": "line", "str": "even outsiders!"},
    {"cmd": "para", "str": "There's more, you"},
    {"cmd": "line", "str": "can now use CUT"},
    {"cmd": "cont", "str": "any time!"},
    {"cmd": "para", "str": "You can CUT down"},
    {"cmd": "line", "str": "small bushes to"},
    {"cmd": "cont", "str": "open new paths!"},
    {"cmd": "para", "str": "You can also have"},
    {"cmd": "line", "str": "my favorite TM!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanGymMistyReceivedTM11Text": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:49",
   "commands": [
    {"cmd": "text", "str": "{PLAYER} received"},
    {"cmd": "line", "str": "TM11!"},
    {"cmd": "text_end"}
   ]
  },
  "_CeruleanGymMistyTM11NoRoomText": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:54",
   "commands": [
    {"cmd": "text", "str": "You better make"},
    {"cmd": "line", "str": "room for this!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanGymMistyReceivedCascadeBadgeText": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:59",
   "commands": [
    {"cmd": "text", "str": "Wow!"},
    {"cmd": "line", "str": "You're too much!"},
    {"cmd": "para", "str": "All right!"},
    {"cmd": "para", "str": "You can have the"},
    {"cmd": "line", "str": "CASCADEBADGE to"},
    {"cmd": "cont", "str": "show you beat me!"},
    {"cmd": "text_end"}
   ]
  },
  "_CeruleanGymBattleText1": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:70",
   "commands": [
    {"cmd": "text", "str": "I'm more than good"},
    {"cmd": "line", "str": "enough for you!"},
    {"cmd": "para", "str": "MISTY can wait!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanGymEndBattleText1": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:77",
   "commands": [
    {"cmd": "text", "str": "You"},
    {"cmd": "line", "str": "overwhelmed me!"},
    {"cmd": "prompt"}
   ]
  },
  "_CeruleanGymAfterBattleText1": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:82",
   "commands": [
    {"cmd": "text", "str": "You have to face"},
    {"cmd": "line", "str": "other trainers to"},
    {"cmd": "cont", "str": "find out how good"},
    {"cmd": "cont", "str": "you really are."},
    {"cmd": "done"}
   ]
  },
  "_CeruleanGymBattleText2": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:89",
   "commands": [
    {"cmd": "text", "str": "Splash!"},
    {"cmd": "para", "str": "I'm first up!"},
    {"cmd": "line", "str": "Let's do it!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanGymEndBattleText2": {
   "kind": "text",
