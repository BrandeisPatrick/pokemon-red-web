  },
  "_CeruleanGymAfterBattleText2": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:101",
   "commands": [
    {"cmd": "text", "str": "MISTY is going to"},
    {"cmd": "line", "str": "keep improving!"},
    {"cmd": "para", "str": "She won't lose to"},
    {"cmd": "line", "str": "someone like you!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanGymGymGuideChampInMakingText": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:109",
   "commands": [
    {"cmd": "text", "str": "Yo! Champ in"},
    {"cmd": "line", "str": "making!"},
    {"cmd": "para", "str": "Here's my advice!"},
    {"cmd": "para", "str": "The LEADER, MISTY,"},
    {"cmd": "line", "str": "is a pro who uses"},
    {"cmd": "cont", "str": "water POKéMON!"},
    {"cmd": "para", "str": "You can drain all"},
    {"cmd": "line", "str": "their water with"},
    {"cmd": "cont", "str": "plant POKéMON!"},
    {"cmd": "para", "str": "Or, zap them with"},
    {"cmd": "line", "str": "electricity!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanGymGymGuideBeatMistyText": {
   "kind": "text",
   "src": "text/CeruleanGym.asm:127",
   "commands": [
    {"cmd": "text", "str": "You beat MISTY!"},
    {"cmd": "line", "str": "What'd I tell ya?"},
    {"cmd": "para", "str": "You and me kid,"},
    {"cmd": "line", "str": "we make a pretty"},
    {"cmd": "cont", "str": "darn good team!"},
    {"cmd": "done"}
   ]
