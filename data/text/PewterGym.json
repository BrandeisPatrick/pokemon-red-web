   ]
  },
  "_PewterGymGuideAdviceText": {
   "kind": "text",
   "src": "text/PewterGym_2.asm:125",
   "commands": [
    {"cmd": "text", "str": "The 1st POKéMON"},
    {"cmd": "line", "str": "out in a match is"},
    {"cmd": "cont", "str": "at the top of the"},
    {"cmd": "cont", "str": "POKéMON LIST!"},
    {"cmd": "para", "str": "By changing the"},
    {"cmd": "line", "str": "order of POKéMON,"},
    {"cmd": "cont", "str": "matches could be"},
    {"cmd": "cont", "str": "made easier!"},
    {"cmd": "done"}
   ]
  },
