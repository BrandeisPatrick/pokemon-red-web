   "kind": "text",
   "src": "text/SilphCo7F.asm:57",
   "commands": [
    {"cmd": "text", "str": "It would be bad"},
    {"cmd": "line", "str": "if TEAM ROCKET"},
    {"cmd": "cont", "str": "took over SILPH"},
    {"cmd": "cont", "str": "or our POKéMON!"},
    {"cmd": "done"}
   ]
  },
