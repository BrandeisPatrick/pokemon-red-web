  "_SilphCo7FRivalWaitedHereText": {
   "kind": "text",
   "src": "text/SilphCo7F.asm:153",
   "commands": [
    {"cmd": "text", "str": "{RIVAL}: Hahaha!"},
    {"cmd": "line", "str": "I thought you'd"},
    {"cmd": "cont", "str": "turn up if I"},
    {"cmd": "cont", "str": "waited here!"},
    {"cmd": "para", "str": "I guess TEAM"},
    {"cmd": "line", "str": "ROCKET slowed you"},
    {"cmd": "cont", "str": "down! Not that I"},
    {"cmd": "cont", "str": "care!"},
    {"cmd": "para", "str": "I saw you in"},
    {"cmd": "line", "str": "SAFFRON, so I"},
    {"cmd": "cont", "str": "decided to see if"},
    {"cmd": "cont", "str": "you got better!"},
    {"cmd": "done"}
   ]
