   "kind": "text",
   "src": "text/SilphCo7F.asm:50",
   "commands": [
    {"cmd": "text", "str": "We canceled the"},
    {"cmd": "line", "str": "MASTER BALL"},
    {"cmd": "cont", "str": "project because"},
    {"cmd": "cont", "str": "of TEAM ROCKET."},
    {"cmd": "done"}
   ]
  },
