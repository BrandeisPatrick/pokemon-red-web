  "_SilphCo7FSilphWorkerM1HaveThisPokemonText": {
   "kind": "text",
   "src": "text/SilphCo7F.asm:2",
   "commands": [
    {"cmd": "text", "str": "Oh! Hi! You're"},
    {"cmd": "line", "str": "not a ROCKET! You"},
    {"cmd": "cont", "str": "came to save us?"},
    {"cmd": "cont", "str": "Why, thank you!"},
    {"cmd": "para", "str": "I want you to"},
    {"cmd": "line", "str": "have this POKéMON"},
    {"cmd": "cont", "str": "for saving us."},
    {"cmd": "prompt"}
   ]
  },
  "_SilphCo7FSilphWorkerM1LaprasDescriptionText": {
   "kind": "text",
   "src": "text/SilphCo7F.asm:13",
   "commands": [
    {"cmd": "text", "str": "It's LAPRAS. It's"},
    {"cmd": "line", "str": "very intelligent."},
    {"cmd": "para", "str": "We kept it in our"},
    {"cmd": "line", "str": "lab, but it will"},
    {"cmd": "cont", "str": "be much better"},
    {"cmd": "cont", "str": "off with you!"},
    {"cmd": "para", "str": "I think you will"},
    {"cmd": "line", "str": "be a good trainer"},
    {"cmd": "cont", "str": "for LAPRAS!"},
    {"cmd": "para", "str": "It's a good"},
    {"cmd": "line", "str": "swimmer. It'll"},
    {"cmd": "cont", "str": "give you a lift!"},
    {"cmd": "done"}
   ]
  },
  "_SilphCo7FSilphWorkerM1IsOurPresidentOkText": {
   "kind": "text",
   "src": "text/SilphCo7F.asm:31",
   "commands": [
    {"cmd": "text", "str": "TEAM ROCKET's"},
    {"cmd": "line", "str": "BOSS went to the"},
    {"cmd": "cont", "str": "boardroom! Is our"},
    {"cmd": "cont", "str": "PRESIDENT OK?"},
    {"cmd": "done"}
   ]
  },
  "_SilphCo7FSilphWorkerM1SavedText": {
   "kind": "text",
   "src": "text/SilphCo7F.asm:38",
   "commands": [
    {"cmd": "text", "str": "Saved at last!"},
    {"cmd": "line", "str": "Thank you!"},
    {"cmd": "done"}
   ]
  },
  "_SilphCo7FSilphWorkerM2AfterTheMasterBallText": {
   "kind": "text",
   "src": "text/SilphCo7F.asm:43",
   "commands": [
    {"cmd": "text", "str": "TEAM ROCKET was"},
    {"cmd": "line", "str": "after the MASTER"},
    {"cmd": "cont", "str": "BALL which will"},
    {"cmd": "cont", "str": "catch any POKéMON!"},
    {"cmd": "done"}
   ]
  },
