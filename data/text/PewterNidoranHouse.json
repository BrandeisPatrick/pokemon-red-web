    {"cmd": "cont", "str": "get in a trade."},
    {"cmd": "para", "str": "It grows fast, but"},
    {"cmd": "line", "str": "it may ignore an"},
    {"cmd": "cont", "str": "unskilled trainer"},
    {"cmd": "cont", "str": "in battle!"},
    {"cmd": "para", "str": "If only we had"},
