  "_LoreleisRoomLoreleiBeforeBattleText": {
   "kind": "text",
   "src": "text/LoreleisRoom.asm:2",
   "commands": [
    {"cmd": "text", "str": "Welcome to"},
    {"cmd": "line", "str": "POKéMON LEAGUE!"},
    {"cmd": "para", "str": "I am LORELEI of"},
    {"cmd": "line", "str": "the ELITE FOUR!"},
    {"cmd": "para", "str": "No one can best"},
    {"cmd": "line", "str": "me when it comes"},
    {"cmd": "cont", "str": "to icy POKéMON!"},
    {"cmd": "para", "str": "Freezing moves"},
    {"cmd": "line", "str": "are powerful!"},
    {"cmd": "para", "str": "Your POKéMON will"},
    {"cmd": "line", "str": "be at my mercy"},
    {"cmd": "cont", "str": "when they are"},
    {"cmd": "cont", "str": "frozen solid!"},
    {"cmd": "para", "str": "Hahaha!"},
    {"cmd": "line", "str": "Are you ready?"},
    {"cmd": "done"}
   ]
  },
