  "_CeladonGymErikaPreBattleText": {
   "kind": "text",
   "src": "text/CeladonGym.asm:2",
   "commands": [
    {"cmd": "text", "str": "Hello. Lovely"},
    {"cmd": "line", "str": "weather isn't it?"},
    {"cmd": "cont", "str": "It's so pleasant."},
    {"cmd": "para", "str": "...Oh dear..."},
    {"cmd": "line", "str": "I must have dozed"},
    {"cmd": "cont", "str": "off. Welcome."},
    {"cmd": "para", "str": "My name is ERIKA."},
    {"cmd": "line", "str": "I am the LEADER"},
    {"cmd": "cont", "str": "of CELADON GYM."},
    {"cmd": "para", "str": "I teach the art of"},
    {"cmd": "line", "str": "flower arranging."},
    {"cmd": "cont", "str": "My POKéMON are of"},
    {"cmd": "cont", "str": "the grass-type."},
    {"cmd": "para", "str": "Oh, I'm sorry, I"},
    {"cmd": "line", "str": "had no idea that"},
    {"cmd": "cont", "str": "you wished to"},
    {"cmd": "cont", "str": "challenge me."},
    {"cmd": "para", "str": "Very well, but I"},
    {"cmd": "line", "str": "shall not lose."},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymErikaReceivedRainbowBadgeText": {
   "kind": "text",
   "src": "text/CeladonGym.asm:29",
   "commands": [
    {"cmd": "text", "str": "Oh!"},
    {"cmd": "line", "str": "I concede defeat."},
    {"cmd": "para", "str": "You are remarkably"},
    {"cmd": "line", "str": "strong."},
    {"cmd": "para", "str": "I must confer you"},
    {"cmd": "line", "str": "the RAINBOWBADGE."},
    {"cmd": "prompt"}
   ]
  },
  "_CeladonGymErikaPostBattleAdviceText": {
   "kind": "text",
   "src": "text/CeladonGym.asm:40",
   "commands": [
    {"cmd": "text", "str": "You are cataloging"},
    {"cmd": "line", "str": "POKéMON? I must"},
    {"cmd": "cont", "str": "say I'm impressed."},
    {"cmd": "para", "str": "I would never"},
    {"cmd": "line", "str": "collect POKéMON"},
    {"cmd": "cont", "str": "if they were"},
    {"cmd": "cont", "str": "unattractive."},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymRainbowBadgeInfoText": {
   "kind": "text",
   "src": "text/CeladonGym.asm:51",
   "commands": [
    {"cmd": "text", "str": "The RAINBOWBADGE"},
    {"cmd": "line", "str": "will make POKéMON"},
    {"cmd": "cont", "str": "up to L50 obey."},
    {"cmd": "para", "str": "It also allows"},
    {"cmd": "line", "str": "POKéMON to use"},
    {"cmd": "cont", "str": "STRENGTH in and"},
    {"cmd": "cont", "str": "out of battle."},
    {"cmd": "para", "str": "Please also take"},
    {"cmd": "line", "str": "this with you."},
    {"cmd": "done"}
   ]
  },
