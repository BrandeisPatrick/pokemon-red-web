    {"cmd": "text_end"}
   ]
  },
  "_TM21ExplanationText": {
   "kind": "text",
   "src": "text/CeladonGym.asm:72",
   "commands": [
    {"cmd": "text", "str": ""},
    {"cmd": "para", "str": "TM21 contains"},
    {"cmd": "line", "str": "MEGA DRAIN."},
    {"cmd": "para", "str": "Half the damage"},
    {"cmd": "line", "str": "it inflicts is"},
    {"cmd": "cont", "str": "drained to heal"},
    {"cmd": "cont", "str": "your POKéMON!"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymTM21NoRoomText": {
   "kind": "text",
   "src": "text/CeladonGym.asm:84",
   "commands": [
    {"cmd": "text", "str": "You should make"},
    {"cmd": "line", "str": "room for this."},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymBattleText2": {
   "kind": "text",
   "src": "text/CeladonGym.asm:89",
   "commands": [
    {"cmd": "text", "str": "Hey!"},
    {"cmd": "para", "str": "You are not"},
    {"cmd": "line", "str": "allowed in here!"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymEndBattleText2": {
   "kind": "text",
   "src": "text/CeladonGym.asm:96",
   "commands": [
    {"cmd": "text", "str": "You're"},
    {"cmd": "line", "str": "too rough!"},
    {"cmd": "prompt"}
   ]
  },
  "_CeladonGymAfterBattleText2": {
   "kind": "text",
   "src": "text/CeladonGym.asm:101",
   "commands": [
    {"cmd": "text", "str": "Bleaah!"},
    {"cmd": "line", "str": "I hope ERIKA"},
    {"cmd": "cont", "str": "wipes you out!"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymBattleText3": {
   "kind": "text",
   "src": "text/CeladonGym.asm:107",
   "commands": [
    {"cmd": "text", "str": "I was getting"},
    {"cmd": "line", "str": "bored."},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymEndBattleText3": {
   "kind": "text",
   "src": "text/CeladonGym.asm:112",
   "commands": [
    {"cmd": "text", "str": "My"},
    {"cmd": "line", "str": "makeup!"},
    {"cmd": "prompt"}
   ]
  },
  "_CeladonGymAfterBattleText3": {
   "kind": "text",
   "src": "text/CeladonGym.asm:117",
   "commands": [
    {"cmd": "text", "str": "Grass-type POKéMON"},
    {"cmd": "line", "str": "are tough against"},
    {"cmd": "cont", "str": "the water-type!"},
    {"cmd": "para", "str": "They also have an"},
    {"cmd": "line", "str": "edge on rock and"},
    {"cmd": "cont", "str": "ground POKéMON!"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymBattleText4": {
   "kind": "text",
   "src": "text/CeladonGym.asm:127",
   "commands": [
    {"cmd": "text", "str": "Aren't you the"},
    {"cmd": "line", "str": "peeping Tom?"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymEndBattleText4": {
   "kind": "text",
   "src": "text/CeladonGym.asm:132",
   "commands": [
    {"cmd": "text", "str": "I'm"},
    {"cmd": "line", "str": "in shock!"},
    {"cmd": "prompt"}
   ]
  },
  "_CeladonGymAfterBattleText4": {
   "kind": "text",
   "src": "text/CeladonGym.asm:137",
   "commands": [
    {"cmd": "text", "str": "Oh, you weren't"},
    {"cmd": "line", "str": "peeping? We get a"},
    {"cmd": "cont", "str": "lot of gawkers!"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymBattleText5": {
   "kind": "text",
   "src": "text/CeladonGym.asm:143",
   "commands": [
    {"cmd": "text", "str": "Look at my grass"},
    {"cmd": "line", "str": "POKéMON!"},
    {"cmd": "para", "str": "They're so easy"},
    {"cmd": "line", "str": "to raise!"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymEndBattleText5": {
   "kind": "text",
   "src": "text/CeladonGym.asm:151",
   "commands": [
    {"cmd": "text", "str": "No!"},
    {"cmd": "prompt"}
   ]
  },
  "_CeladonGymAfterBattleText5": {
   "kind": "text",
   "src": "text/CeladonGym.asm:155",
   "commands": [
    {"cmd": "text", "str": "We only use grass-"},
    {"cmd": "line", "str": "type POKéMON at"},
    {"cmd": "cont", "str": "our GYM!"},
    {"cmd": "para", "str": "We also use them"},
    {"cmd": "line", "str": "for making flower"},
    {"cmd": "cont", "str": "arrangements!"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymBattleText6": {
   "kind": "text",
   "src": "text/CeladonGym.asm:165",
   "commands": [
    {"cmd": "text", "str": "Don't bring any"},
    {"cmd": "line", "str": "bugs or fire"},
    {"cmd": "cont", "str": "POKéMON in here!"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymEndBattleText6": {
   "kind": "text",
   "src": "text/CeladonGym.asm:171",
   "commands": [
    {"cmd": "text", "str": "Oh!"},
    {"cmd": "line", "str": "You!"},
    {"cmd": "prompt"}
   ]
  },
  "_CeladonGymAfterBattleText6": {
   "kind": "text",
   "src": "text/CeladonGym.asm:176",
   "commands": [
    {"cmd": "text", "str": "Our LEADER, ERIKA,"},
    {"cmd": "line", "str": "might be quiet,"},
    {"cmd": "cont", "str": "but she's also"},
    {"cmd": "cont", "str": "very skilled!"},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymBattleText7": {
   "kind": "text",
   "src": "text/CeladonGym.asm:183",
   "commands": [
    {"cmd": "text", "str": "Pleased to meet"},
    {"cmd": "line", "str": "you. My hobby is"},
    {"cmd": "cont", "str": "POKéMON training."},
    {"cmd": "done"}
   ]
  },
  "_CeladonGymEndBattleText7": {
   "kind": "text",
   "src": "text/CeladonGym.asm:189",
   "commands": [
    {"cmd": "text", "str": "Oh!"},
    {"cmd": "line", "str": "Splendid!"},
    {"cmd": "prompt"}
