  "_DaycareGentlemanIntroText": {
   "kind": "text",
   "src": "text/Daycare.asm:2",
   "commands": [
    {"cmd": "text", "str": "I run a DAYCARE."},
    {"cmd": "line", "str": "Would you like me"},
    {"cmd": "cont", "str": "to raise one of"},
    {"cmd": "cont", "str": "your POKéMON?"},
    {"cmd": "done"}
   ]
  },
  "_DaycareGentlemanWhichMonText": {
   "kind": "text",
   "src": "text/Daycare.asm:9",
   "commands": [
    {"cmd": "text", "str": "Which POKéMON"},
    {"cmd": "line", "str": "should I raise?"},
    {"cmd": "prompt"}
   ]
  },
  "_DaycareGentlemanWillLookAfterMonText": {
   "kind": "text",
   "src": "text/Daycare.asm:14",
   "commands": [
    {"cmd": "text", "str": "Fine, I'll look"},
    {"cmd": "line", "str": "after "},
    {"cmd": "text_ram", "ram": "wNameBuffer"},
    {"cmd": "text", "str": ""},
    {"cmd": "cont", "str": "for a while."},
    {"cmd": "prompt"}
   ]
  },
  "_DaycareGentlemanComeSeeMeInAWhileText": {
   "kind": "text",
   "src": "text/Daycare.asm:22",
