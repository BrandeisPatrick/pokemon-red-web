    {"cmd": "done"}
   ]
  },
  "_DaycareGentlemanMonHasGrownText": {
   "kind": "text",
   "src": "text/Daycare.asm:27",
   "commands": [
    {"cmd": "text", "str": "Your "},
    {"cmd": "text_ram", "ram": "wNameBuffer"},
    {"cmd": "text", "str": ""},
    {"cmd": "line", "str": "has grown a lot!"},
    {"cmd": "para", "str": "By level, it's"},
    {"cmd": "line", "str": "grown by "},
    {"cmd": "text_decimal", "ram": "wDayCareNumLevelsGrown", "bytes": 1, "digits": 3},
    {"cmd": "text", "str": "!"},
    {"cmd": "para", "str": "Aren't I great?"},
    {"cmd": "prompt"}
   ]
  },
  "_DaycareGentlemanOweMoneyText": {
   "kind": "text",
   "src": "text/Daycare.asm:41",
