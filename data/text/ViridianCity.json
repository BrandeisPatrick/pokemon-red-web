    {"cmd": "para", "str": "What? Don't you"},
    {"cmd": "line", "str": "know how to catch"},
    {"cmd": "cont", "str": "POKéMON?"},
    {"cmd": "para", "str": "I'll show you"},
    {"cmd": "line", "str": "how to then."},
    {"cmd": "done"}
   ]
