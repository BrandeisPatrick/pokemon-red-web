  "_SafariZoneGateSafariZoneWorker2SafariZoneExplanationText": {
   "kind": "text",
   "src": "text/SafariZoneGate.asm:73",
   "commands": [
    {"cmd": "text", "str": "SAFARI ZONE has 4"},
    {"cmd": "line", "str": "zones in it."},
    {"cmd": "para", "str": "Each zone has"},
    {"cmd": "line", "str": "different kinds"},
    {"cmd": "cont", "str": "of POKéMON. Use"},
    {"cmd": "cont", "str": "SAFARI BALLs to"},
    {"cmd": "cont", "str": "catch them!"},
    {"cmd": "para", "str": "When you run out"},
    {"cmd": "line", "str": "of time or SAFARI"},
    {"cmd": "cont", "str": "BALLs, it's game"},
    {"cmd": "cont", "str": "over for you!"},
    {"cmd": "para", "str": "Before you go,"},
    {"cmd": "line", "str": "open an unused"},
    {"cmd": "cont", "str": "POKéMON BOX so"},
    {"cmd": "cont", "str": "there's room for"},
    {"cmd": "cont", "str": "new POKéMON!"},
    {"cmd": "done"}
   ]
  },
