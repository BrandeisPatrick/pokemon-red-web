  "_SafariZoneGateSafariZoneWorker1WouldYouLikeToJoinText": {
   "kind": "text",
   "src": "text/SafariZoneGate.asm:7",
   "commands": [
    {"cmd": "text", "str": "For just ¥500,"},
    {"cmd": "line", "str": "you can catch all"},
    {"cmd": "cont", "str": "the POKéMON you"},
    {"cmd": "cont", "str": "want in the park!"},
    {"cmd": "para", "str": "Would you like to"},
    {"cmd": "line", "str": "join the hunt?"},
    {"cmd": "text_end"}
   ]
  },
  "_SafariZoneGateSafariZoneWorker1ThatllBe500PleaseText": {
   "kind": "text",
   "src": "text/SafariZoneGate.asm:17",
   "commands": [
    {"cmd": "text", "str": "That'll be ¥500"},
    {"cmd": "line", "str": "please!"},
    {"cmd": "para", "str": "We only use a"},
    {"cmd": "line", "str": "special POKé BALL"},
    {"cmd": "cont", "str": "here."},
    {"cmd": "para", "str": "{PLAYER} received"},
    {"cmd": "line", "str": "30 SAFARI BALLs!"},
    {"cmd": "text_end"}
   ]
  },
