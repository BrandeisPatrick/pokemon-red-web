    {"cmd": "para", "str": "We'll call you on"},
    {"cmd": "line", "str": "the PA when you"},
    {"cmd": "cont", "str": "run out of time"},
    {"cmd": "cont", "str": "or SAFARI BALLs!"},
    {"cmd": "done"}
   ]
  },
