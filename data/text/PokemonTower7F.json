  "_PokemonTower7FMrFujiRescueText": {
   "kind": "text",
   "src": "text/PokemonTower7F.asm:2",
   "commands": [
    {"cmd": "text", "str": "MR.FUJI: Heh? You"},
    {"cmd": "line", "str": "came to save me?"},
    {"cmd": "para", "str": "Thank you. But, I"},
    {"cmd": "line", "str": "came here of my"},
    {"cmd": "cont", "str": "own free will."},
    {"cmd": "para", "str": "I came to calm"},
    {"cmd": "line", "str": "the soul of"},
    {"cmd": "cont", "str": "CUBONE's mother."},
    {"cmd": "para", "str": "I think MAROWAK's"},
    {"cmd": "line", "str": "spirit has gone"},
    {"cmd": "cont", "str": "to the afterlife."},
    {"cmd": "para", "str": "I must thank you"},
    {"cmd": "line", "str": "for your kind"},
    {"cmd": "cont", "str": "concern!"},
    {"cmd": "para", "str": "Follow me to my"},
    {"cmd": "line", "str": "home, POKéMON"},
    {"cmd": "cont", "str": "HOUSE at the foot"},
    {"cmd": "cont", "str": "of this tower."},
    {"cmd": "done"}
   ]
  },
  "_PokemonTower7FRocket1BattleText": {
   "kind": "text",
   "src": "text/PokemonTower7F.asm:28",
   "commands": [
    {"cmd": "text", "str": "What do you want?"},
    {"cmd": "line", "str": "Why are you here?"},
    {"cmd": "done"}
   ]
  },
  "_PokemonTower7FRocket1EndBattleText": {
   "kind": "text",
   "src": "text/PokemonTower7F.asm:33",
   "commands": [
    {"cmd": "text", "str": "I give up!"},
    {"cmd": "prompt"}
   ]
  },
  "_PokemonTower7FRocket1AfterBattleText": {
   "kind": "text",
   "src": "text/PokemonTower7F.asm:37",
   "commands": [
    {"cmd": "text", "str": "I'm not going to"},
    {"cmd": "line", "str": "forget this!"},
    {"cmd": "done"}
   ]
  },
  "_PokemonTower7FRocket2BattleText": {
   "kind": "text",
   "src": "text/PokemonTower7F.asm:42",
   "commands": [
    {"cmd": "text", "str": "This old guy came"},
    {"cmd": "line", "str": "and complained"},
    {"cmd": "cont", "str": "about us harming"},
    {"cmd": "cont", "str": "useless POKéMON!"},
    {"cmd": "para", "str": "We're talking it"},
    {"cmd": "line", "str": "over as adults!"},
    {"cmd": "done"}
   ]
  },
  "_PokemonTower7FRocket2EndBattleText": {
   "kind": "text",
   "src": "text/PokemonTower7F.asm:52",
   "commands": [
    {"cmd": "text", "str": "Please!"},
    {"cmd": "line", "str": "No more!"},
    {"cmd": "prompt"}
   ]
  },
  "_PokemonTower7FRocket2AfterBattleText": {
   "kind": "text",
   "src": "text/PokemonTower7F.asm:57",
   "commands": [
    {"cmd": "text", "str": "POKéMON are only"},
    {"cmd": "line", "str": "good for making"},
    {"cmd": "cont", "str": "money!"},
    {"cmd": "para", "str": "Stay out of our"},
    {"cmd": "line", "str": "business!"},
    {"cmd": "done"}
   ]
  },
  "_PokemonTower7FRocket3BattleText": {
   "kind": "text",
   "src": "text/PokemonTower7F.asm:66",
   "commands": [
    {"cmd": "text", "str": "You're not saving"},
    {"cmd": "line", "str": "anyone, kid!"},
    {"cmd": "done"}
   ]
  },
