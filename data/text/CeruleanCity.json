  "_CeruleanCityRivalPreBattleText": {
   "kind": "text",
   "src": "text/CeruleanCity.asm:2",
   "commands": [
    {"cmd": "text", "str": "{RIVAL}: Yo!"},
    {"cmd": "line", "str": "{PLAYER}!"},
    {"cmd": "para", "str": "You're still"},
    {"cmd": "line", "str": "struggling along"},
    {"cmd": "cont", "str": "back here?"},
    {"cmd": "para", "str": "I'm doing great!"},
    {"cmd": "line", "str": "I caught a bunch"},
    {"cmd": "cont", "str": "of strong and"},
    {"cmd": "cont", "str": "smart POKéMON!"},
    {"cmd": "para", "str": "Here, let me see"},
    {"cmd": "line", "str": "what you caught,"},
    {"cmd": "cont", "str": "{PLAYER}!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanCityRivalDefeatedText": {
   "kind": "text",
   "src": "text/CeruleanCity.asm:20",
   "commands": [
    {"cmd": "text", "str": "Hey!"},
    {"cmd": "line", "str": "Take it easy!"},
    {"cmd": "cont", "str": "You won already!"},
    {"cmd": "prompt"}
   ]
  },
  "_CeruleanCityRivalVictoryText": {
   "kind": "text",
   "src": "text/CeruleanCity.asm:26",
   "commands": [
    {"cmd": "text", "str": "Heh!"},
    {"cmd": "line", "str": "You're no match"},
    {"cmd": "cont", "str": "for my genius!"},
    {"cmd": "prompt"}
   ]
  },
  "_CeruleanCityRivalIWentToBillsText": {
   "kind": "text",
   "src": "text/CeruleanCity.asm:32",
   "commands": [
    {"cmd": "text", "str": "{RIVAL}: Hey,"},
    {"cmd": "line", "str": "guess what?"},
    {"cmd": "para", "str": "I went to BILL's"},
    {"cmd": "line", "str": "and got him to"},
    {"cmd": "cont", "str": "show me his rare"},
    {"cmd": "cont", "str": "POKéMON!"},
    {"cmd": "para", "str": "That added a lot"},
    {"cmd": "line", "str": "of pages to my"},
    {"cmd": "cont", "str": "POKéDEX!"},
    {"cmd": "para", "str": "After all, BILL's"},
    {"cmd": "line", "str": "world famous as a"},
    {"cmd": "cont", "str": "POKéMANIAC!"},
    {"cmd": "para", "str": "He invented the"},
    {"cmd": "line", "str": "POKéMON Storage"},
    {"cmd": "cont", "str": "System on PC!"},
    {"cmd": "para", "str": "Since you're using"},
    {"cmd": "line", "str": "his system, go"},
    {"cmd": "cont", "str": "thank him!"},
    {"cmd": "para", "str": "Well, I better"},
    {"cmd": "line", "str": "get rolling!"},
    {"cmd": "cont", "str": "Smell ya later!"},
    {"cmd": "done"}
   ]
  },
  "_CeruleanCityRocketText": {
   "kind": "text",
   "src": "text/CeruleanCity.asm:62",
   "commands": [
    {"cmd": "text", "str": "Hey! Stay out!"},
    {"cmd": "line", "str": "It's not your"},
    {"cmd": "cont", "str": "yard! Huh? Me?"},
    {"cmd": "para", "str": "I'm an innocent"},
    {"cmd": "line", "str": "bystander! Don't"},
    {"cmd": "cont", "str": "you believe me?"},
    {"cmd": "done"}
   ]
  },
