   "kind": "text",
   "src": "text/CopycatsHouse2F.asm:2",
   "commands": [
    {"cmd": "text", "str": "{PLAYER}: Hi! Do"},
    {"cmd": "line", "str": "you like POKéMON?"},
    {"cmd": "para", "str": "{PLAYER}: Uh no, I"},
    {"cmd": "line", "str": "just asked you."},
    {"cmd": "para", "str": "{PLAYER}: Huh?"},
    {"cmd": "line", "str": "You're strange!"},
    {"cmd": "para", "str": "COPYCAT: Hmm?"},
    {"cmd": "line", "str": "Quit mimicking?"},
    {"cmd": "para", "str": "But, that's my"},
    {"cmd": "line", "str": "favorite hobby!"},
    {"cmd": "prompt"}
   ]
  },
