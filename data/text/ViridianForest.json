  },
  "_ViridianForestYoungster2BattleText": {
   "kind": "text",
   "src": "text/ViridianForest.asm:10",
   "commands": [
    {"cmd": "text", "str": "Hey! You have"},
    {"cmd": "line", "str": "POKéMON! Come on!"},
    {"cmd": "cont", "str": "Let's battle'em!"},
    {"cmd": "done"}
   ]
  },
  "_ViridianForestYoungster2EndBattleText": {
