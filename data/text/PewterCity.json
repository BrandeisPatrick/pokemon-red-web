  "_PewterCityCooltrainerFText": {
   "kind": "text",
   "src": "text/PewterCity.asm:2",
   "commands": [
    {"cmd": "text", "str": "It's rumored that"},
    {"cmd": "line", "str": "CLEFAIRYs came"},
    {"cmd": "cont", "str": "from the moon!"},
    {"cmd": "para", "str": "They appeared "},
    {"cmd": "line", "str": "after MOON STONE"},
    {"cmd": "cont", "str": "fell on MT.MOON."},
    {"cmd": "done"}
   ]
  },
  "_PewterCityCooltrainerMText": {
   "kind": "text",
   "src": "text/PewterCity.asm:12",
   "commands": [
    {"cmd": "text", "str": "There aren't many"},
    {"cmd": "line", "str": "serious POKéMON"},
    {"cmd": "cont", "str": "trainers here!"},
    {"cmd": "para", "str": "They're all like"},
    {"cmd": "line", "str": "BUG CATCHERs,"},
    {"cmd": "cont", "str": "but PEWTER GYM's"},
    {"cmd": "cont", "str": "BROCK is totally"},
    {"cmd": "cont", "str": "into it!"},
    {"cmd": "done"}
   ]
  },
