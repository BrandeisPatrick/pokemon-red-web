  "_SilphCo11FSilphPresidentText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:2",
   "commands": [
    {"cmd": "text", "str": "PRESIDENT: Thank"},
    {"cmd": "line", "str": "you for saving"},
    {"cmd": "cont", "str": "SILPH!"},
    {"cmd": "para", "str": "I will never"},
    {"cmd": "line", "str": "forget you saved"},
    {"cmd": "cont", "str": "us in our moment"},
    {"cmd": "cont", "str": "of peril!"},
    {"cmd": "para", "str": "I have to thank"},
    {"cmd": "line", "str": "you in some way!"},
    {"cmd": "para", "str": "Because I am rich,"},
    {"cmd": "line", "str": "I can give you"},
    {"cmd": "cont", "str": "anything!"},
    {"cmd": "para", "str": "Here, maybe this"},
    {"cmd": "line", "str": "will do!"},
    {"cmd": "prompt"}
   ]
  },
  "_SilphCo11FSilphPresidentReceivedMasterBallText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:23",
   "commands": [
    {"cmd": "text", "str": "{PLAYER} got a"},
    {"cmd": "line", "str": ""},
    {"cmd": "text_ram", "ram": "wStringBuffer"},
    {"cmd": "text", "str": "!"},
    {"cmd": "text_end"}
   ]
  },
  "_SilphCo11FSilphPresidentMasterBallDescriptionText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:30",
   "commands": [
    {"cmd": "text", "str": "PRESIDENT: You"},
    {"cmd": "line", "str": "can't buy that"},
    {"cmd": "cont", "str": "anywhere!"},
    {"cmd": "para", "str": "It's our secret"},
    {"cmd": "line", "str": "prototype MASTER"},
    {"cmd": "cont", "str": "BALL!"},
    {"cmd": "para", "str": "It will catch any"},
    {"cmd": "line", "str": "POKéMON without"},
    {"cmd": "cont", "str": "fail!"},
    {"cmd": "para", "str": "You should be"},
    {"cmd": "line", "str": "quiet about using"},
    {"cmd": "cont", "str": "it, though."},
    {"cmd": "done"}
   ]
  },
  "_SilphCo11FSilphPresidentNoRoomText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:48",
   "commands": [
    {"cmd": "text", "str": "You have no"},
    {"cmd": "line", "str": "room for this."},
    {"cmd": "done"}
   ]
  },
  "_SilphCo11FBeautyText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:53",
   "commands": [
    {"cmd": "text", "str": "SECRETARY: Thank"},
    {"cmd": "line", "str": "you for rescuing"},
    {"cmd": "cont", "str": "all of us!"},
    {"cmd": "para", "str": "We admire your"},
    {"cmd": "line", "str": "courage."},
    {"cmd": "done"}
   ]
  },
  "_SilphCo11FGiovanniText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:62",
   "commands": [
    {"cmd": "text", "str": "Ah {PLAYER}!"},
    {"cmd": "line", "str": "So we meet again!"},
    {"cmd": "para", "str": "The PRESIDENT and"},
    {"cmd": "line", "str": "I are discussing"},
    {"cmd": "cont", "str": "a vital business"},
    {"cmd": "cont", "str": "proposition."},
    {"cmd": "para", "str": "Keep your nose"},
    {"cmd": "line", "str": "out of grown-up"},
    {"cmd": "cont", "str": "matters..."},
    {"cmd": "para", "str": "Or, experience a"},
    {"cmd": "line", "str": "world of pain!"},
    {"cmd": "done"}
   ]
  },
  "_SilphCo11FGiovanniILostAgainText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:79",
   "commands": [
    {"cmd": "text", "str": "Arrgh!!"},
    {"cmd": "line", "str": "I lost again!?"},
    {"cmd": "prompt"}
   ]
  },
  "_SilphCo11FGiovanniYouRuinedOurPlansText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:84",
   "commands": [
    {"cmd": "text", "str": "Blast it all!"},
    {"cmd": "line", "str": "You ruined our"},
    {"cmd": "cont", "str": "plans for SILPH!"},
    {"cmd": "para", "str": "But, TEAM ROCKET"},
    {"cmd": "line", "str": "will never fall!"},
    {"cmd": "para", "str": "{PLAYER}! Never"},
    {"cmd": "line", "str": "forget that all"},
    {"cmd": "cont", "str": "POKéMON exist"},
    {"cmd": "cont", "str": "for TEAM ROCKET!"},
    {"cmd": "para", "str": "I must go, but I"},
    {"cmd": "line", "str": "shall return!"},
    {"cmd": "done"}
   ]
  },
  "_SilphCo11FRocket1BattleText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:101",
   "commands": [
    {"cmd": "text", "str": "Stop right there!"},
    {"cmd": "line", "str": "Don't you move!"},
    {"cmd": "done"}
   ]
  },
  "_SilphCo11FRocket1EndBattleText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:106",
   "commands": [
    {"cmd": "text", "str": "Don't..."},
    {"cmd": "line", "str": "Please!"},
    {"cmd": "prompt"}
   ]
  },
  "_SilphCo11FRocket1AfterBattleText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:111",
   "commands": [
    {"cmd": "text", "str": "So, you want to"},
    {"cmd": "line", "str": "see my BOSS?"},
    {"cmd": "done"}
   ]
  },
  "_SilphCo11FRocket2BattleText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:116",
   "commands": [
    {"cmd": "text", "str": "Halt! Do you have"},
    {"cmd": "line", "str": "an appointment"},
    {"cmd": "cont", "str": "with my BOSS?"},
    {"cmd": "done"}
   ]
  },
  "_SilphCo11FRocket2EndBattleText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:122",
   "commands": [
    {"cmd": "text", "str": "Gaah!"},
    {"cmd": "line", "str": "Demolished!"},
    {"cmd": "prompt"}
   ]
  },
  "_SilphCo11FRocket2AfterBattleText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:127",
   "commands": [
    {"cmd": "text", "str": "Watch your step,"},
    {"cmd": "line", "str": "my BOSS likes his"},
    {"cmd": "cont", "str": "POKéMON tough!"},
    {"cmd": "done"}
   ]
  },
  "_SilphCo11FPorygonText": {
   "kind": "text",
   "src": "text/SilphCo11F.asm:133",
   "commands": [
    {"cmd": "text", "str": "The monitor has"},
