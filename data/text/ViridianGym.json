  "_ViridianGymGiovanniPreBattleText": {
   "kind": "text",
   "src": "text/ViridianGym.asm:2",
   "commands": [
    {"cmd": "text", "str": "Fwahahaha! This is"},
    {"cmd": "line", "str": "my hideout!"},
    {"cmd": "para", "str": "I planned to"},
    {"cmd": "line", "str": "resurrect TEAM"},
    {"cmd": "cont", "str": "ROCKET here!"},
    {"cmd": "para", "str": "But, you have"},
    {"cmd": "line", "str": "caught me again!"},
    {"cmd": "cont", "str": "So be it! This"},
    {"cmd": "cont", "str": "time, I'm not"},
    {"cmd": "cont", "str": "holding back!"},
    {"cmd": "para", "str": "Once more, you"},
    {"cmd": "line", "str": "shall face"},
    {"cmd": "cont", "str": "GIOVANNI, the"},
    {"cmd": "cont", "str": "greatest trainer!"},
    {"cmd": "done"}
   ]
  },
  "_ViridianGymGiovanniReceivedEarthBadgeText": {
   "kind": "text",
   "src": "text/ViridianGym.asm:22",
   "commands": [
    {"cmd": "text", "str": "Ha!"},
    {"cmd": "line", "str": "That was a truly"},
    {"cmd": "cont", "str": "intense fight!"},
    {"cmd": "cont", "str": "You have won!"},
    {"cmd": "cont", "str": "As proof, here is"},
    {"cmd": "cont", "str": "the EARTHBADGE!"},
    {"cmd": "text_end"}
   ]
  },
  "_ViridianGymGiovanniPostBattleAdviceText": {
   "kind": "text",
   "src": "text/ViridianGym.asm:31",
   "commands": [
    {"cmd": "text", "str": "Having lost, I"},
    {"cmd": "line", "str": "cannot face my"},
    {"cmd": "cont", "str": "underlings!"},
    {"cmd": "cont", "str": "TEAM ROCKET is"},
    {"cmd": "cont", "str": "finished forever!"},
    {"cmd": "para", "str": "I will dedicate my"},
    {"cmd": "line", "str": "life to the study"},
    {"cmd": "cont", "str": "of POKéMON!"},
    {"cmd": "para", "str": "Let us meet again"},
    {"cmd": "line", "str": "some day!"},
    {"cmd": "cont", "str": "Farewell!"},
    {"cmd": "text_end"}
   ]
  },
  "_ViridianGymGiovanniEarthBadgeInfoText": {
   "kind": "text",
   "src": "text/ViridianGym.asm:47",
   "commands": [
    {"cmd": "text", "str": "The EARTHBADGE"},
    {"cmd": "line", "str": "makes POKéMON of"},
    {"cmd": "cont", "str": "any level obey!"},
    {"cmd": "para", "str": "It is evidence of"},
    {"cmd": "line", "str": "your mastery as a"},
    {"cmd": "cont", "str": "POKéMON trainer!"},
    {"cmd": "para", "str": "With it, you can"},
    {"cmd": "line", "str": "enter the POKéMON"},
    {"cmd": "cont", "str": "LEAGUE!"},
    {"cmd": "para", "str": "It is my gift for"},
    {"cmd": "line", "str": "your POKéMON"},
    {"cmd": "cont", "str": "LEAGUE challenge!"},
    {"cmd": "done"}
   ]
  },
