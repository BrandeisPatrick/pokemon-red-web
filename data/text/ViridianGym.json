  "_ViridianGymGiovanniTM27ExplanationText": {
   "kind": "text",
   "src": "text/ViridianGym.asm:70",
   "commands": [
    {"cmd": "text", "str": ""},
    {"cmd": "para", "str": "TM27 is FISSURE!"},
    {"cmd": "line", "str": "It will take out"},
    {"cmd": "cont", "str": "POKéMON with just"},
    {"cmd": "cont", "str": "one hit!"},
    {"cmd": "para", "str": "I made it when I"},
    {"cmd": "line", "str": "ran the GYM here,"},
    {"cmd": "cont", "str": "too long ago..."},
    {"cmd": "done"}
   ]
  },
